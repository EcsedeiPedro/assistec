// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Company {
  id        String   @id @default(uuid())
  name      String
  createdAt DateTime @default(now())

  boxes Box[]

  documents Document[]
}

model Box {
  id          String   @id @default(cuid())
  number      Int      @unique
  observation String?
  createdAt   DateTime @default(now())

  companies Company[]

  documents Document[]
}

model Document {
  id          String   @id @default(cuid())
  name        String

  dateFrom    DateTime
  dateTo      DateTime

  observation String?
  
  createdAt   DateTime @default(now())

  boxId String
  box   Box    @relation(fields: [boxId], references: [id])

  companyId String
  company   Company @relation(fields: [companyId], references: [id])

  @@index([name])
}

model AuthorizedUser {
  id String @id @default(uuid())

  cpf String @unique

  firstName String @map("first_name")
  lastName  String @map("last_name")

  email String @unique

  active Boolean @default(true)

  isRegistered Boolean @default(false) @map("is_registered")

  createdAt DateTime @default(now()) @map("created_at")

  profile Profile?

  @@map("authorized_users")
}

model Profile {
  id String @id

  authorizedUserId String @unique @map("authorized_user_id")

  authorizedUser AuthorizedUser @relation(fields: [authorizedUserId], references: [id], onDelete: Cascade)

  cpf String @unique

  firstName String @map("first_name")
  lastName  String @map("last_name")

  email String @unique

  avatarUrl String? @map("avatar_url")

  createdAt DateTime @default(now()) @map("created_at")

  @@map("profiles")
}
